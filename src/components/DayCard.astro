---
type Props = {
	day: string,
	adress: string,
	hours: string,
}

const {day, adress, hours} = Astro.props

---
<div class="rounded-2xl bg-white p-5 text-ink">
	<p class="font-display text-xl font-bold text-gold">{day}</p>
	<p class="mt-3 font-bold">{adress}</p>
	<p class="text-sm text-slate-950">{hours}</p>
</div>