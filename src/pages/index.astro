---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import ValueCard from '../components/ValueCard.astro';
import DayCard from '../components/DayCard.astro';
import PizzaMenu from '../components/PizzaMenu.astro';

// Lire les données de src/content des fichiers json de DecapCMS
const pizzaModules = import.meta.glob('../content/pizza/*.json', { eager: true });
const tourModules = import.meta.glob('../content/tour/*.json', { eager: true });
const heroModules = import.meta.glob('../content/hero/*.json', { eager: true });


// Charger toutes les pizzas
const allPizzas = Object.entries(pizzaModules).map(([path, module]) => {
	// @ts-ignore
	const data = module.default;
	return {
		name: data.name,
		ingredients: data.ingredients,
		base: data.base,
		price26: data.price26,
		price31: data.price31,
	};
});

// Filtrer par base
const tomatoPizzas = allPizzas.filter(p => p.base === 'Tomate').sort((a, b) => a.price26 - b.price26);
const creamPizzas = allPizzas.filter(p => p.base === 'Crème fraîche').sort((a, b) => a.price26 - b.price26);
const sweetPizzas = allPizzas.filter(p => p.base === 'Sucrée');

// tournée data
// Charger la tournée du camion
const week = ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi", "Dimanche"];

const allTour = Object.entries(tourModules).map(([path, module]) => {
	// @ts-ignore
	const data = module.default;
	return {
		day: data.weekday,
		adress: data.adress,
		hourStart: data.hourStart,
		hourEnd: data.hourEnd,
	};
})
.sort((a, b) => {
	const indexA = week.indexOf(a.day);
	const indexB = week.indexOf(b.day);
	return indexA - indexB;
});

// hero data
const heroModule = Object.values(heroModules)[0];
// @ts-ignore
const dataHero = heroModule.default;

const heroContent = {
	tel: dataHero.tel,
	heroImg: dataHero.heroImg,
	historyImg: dataHero.historyImg
};
const htmlTel = heroContent.tel.replace(/\s/g, '').replace(/^0/, '');
---


<Layout>
	<Navbar htmlTel={htmlTel}/>
	<main id="top">
		<section class="dot-grid overflow-hidden bg-royal">
			<div class="relative mx-auto grid max-w-7xl items-center gap-10 px-5 py-16 sm:py-20 lg:grid-cols-[1.1fr_.9fr] lg:px-8 lg:py-24">
				<div class="relative z-10 max-w-2xl">
					<h1 class="font-display text-5xl font-bold leading-[.92] text-white sm:text-6xl lg:text-7xl">La
						pizza qui<br /><span class="doodle text-gold">fait le tour</span><br />de vos envies.</h1>
					<p class="mt-6 max-w-lg text-lg leading-relaxed text-white/90">Des recettes généreuses, une pâte travaillée avec soin et des ingrédients choisis. Tino Pizz' s'arrête près de chez vous.</p>
					<div class="mt-8 flex flex-wrap gap-4">
						<Button href='#carte' style='secondary'>Voir la carte <span aria-hidden="true">→</span></Button>
						<Button href='#tournee' style='tertiary'>Où nous trouver</Button>
					</div>
				</div>
				<div class="relative mx-auto w-full max-w-md lg:max-w-none">
					<div class="absolute -inset-3 rotate-3 rounded-[2rem] bg-gold"></div>
					<div
						class="relative overflow-hidden rounded-[1.7rem] border-4 border-navy bg-navy shadow-[10px_10px_0_navy]">
						<img src={heroContent.heroImg}
							alt="camion de tino"
							class="h-[390px] w-full object-cover sm:h-[460px]" />
					</div>
				</div>
			</div>
		</section>

		<section class="border-y-2 border-navy bg-gold py-4">
			<div
				class="flex justify-center gap-5 overflow-hidden whitespace-nowrap font-display text-xl font-bold text-navy sm:gap-10 sm:text-2xl">
				<span>• PÂTE MAISON</span><span>• PRODUITS FRAIS</span><span>• RECETTES GÉNÉREUSES</span><span>• PÂTE
					MAISON</span></div>
		</section>

		<section id="carte" class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
			<div class="mb-10 flex flex-wrap items-end justify-between gap-5">
				<div>
					<p class="font-display text-lg text-tomato">À déguster sans modération</p>
					<h2 class="font-display text-4xl font-bold text-navy sm:text-5xl">Notre carte</h2>
					<p class="mt-3 max-w-xl text-slate-600">Choisissez votre recette et votre format. Toutes nos pizzas
						sont préparées à la commande.</p>
				</div>
				<Button href=`tel:+33${htmlTel}` style='primaryBig'>Commander au {heroContent.tel}</Button>
			</div>

			<PizzaMenu
				title="Pizzas base sauce tomate"
				headerColor="bg-tomato"
				pizzas={tomatoPizzas}
			/>

			<PizzaMenu
				title="Pizzas base crème fraîche"
				headerColor="bg-royal"
				pizzas={creamPizzas}
			/>

			<PizzaMenu
				title="Pizzas sucrées"
				headerColor="bg-navy"
				pizzas={sweetPizzas}
				sizes="31"
			/>
			<div class="overflow-hidden rounded-3xl border-2 border-navy bg-white shadow-punch">
				<div class="flex items-center gap-3 bg-navy px-5 py-4 text-white sm:px-7">
					<h3 class="font-display text-2xl font-bold">Paninis</h3><span
						class="rounded-full bg-gold px-3 py-1 text-xs font-bold text-navy">Prix unique</span>
				</div>
				<div class="grid divide-y divide-navy/10 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
					<div class="p-5 sm:px-7">
						<p class="font-display text-lg text-navy">Crème fraîche, saumon</p>
						<p class="mt-3 font-display text-lg text-navy">Crème fraîche, poulet, oignons</p>
						<p class="mt-3 font-display text-lg text-navy">Tomate, bacon, chèvre</p>
						<p class="mt-3 font-display text-lg text-navy">Tomate, jambon</p>
					</div>
					<div class="p-5 sm:px-7">
						<p class="font-display text-lg text-navy">Poulet, curry, oignons</p>
						<p class="mt-3 font-display text-lg text-navy">Crème fraîche, kebab, oignons</p>
						<p class="mt-3 font-display text-lg text-navy">Crème fraîche, chèvre, raclette</p>
						<p class="mt-3 font-display text-lg text-navy">Chocolat</p>
					</div>
				</div>
				<div
					class="border-t-2 border-navy bg-gold px-5 py-3 text-center font-display text-xl font-bold text-navy">
					Tous les paninis : 6,00 €</div>
			</div>
		</section>

		<section id="tournee" class="bg-royal py-20 text-white">
			<div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[.85fr_1.15fr] lg:px-8">
				<div>
					<p class="font-display text-lg text-gold">La tournée de la semaine</p>
					<h2 class="mt-1 font-display text-4xl font-bold sm:text-5xl">Le camion<br />vient à vous.</h2>
					<p class="mt-5 mb-8 max-w-md leading-relaxed text-white">Retrouvez Tino Pizz' chaque semaine dans vos villes et villages. Passez votre commande à l'avance pour être sûr de vous régaler.</p>
					<Button href=`tel:+33${htmlTel}` style='primaryBig'>Commander au {heroContent.tel}</Button>
				</div>
				<div class="grid gap-3 sm:grid-cols-2">
					{allTour.map((tour, index) => (
						<DayCard key={index} day={tour.day} adress={tour.adress} hours={`${tour.hourStart} - ${tour.hourEnd}`} />
					))}
				</div>
			</div>
		</section>

		<section id="savoir-faire" class="relative overflow-hidden px-5 py-20 lg:px-8">
			<div class="relative mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">
				<div class="relative">
					<div class="absolute -inset-3 -rotate-3 rounded-3xl bg-tomato"></div>
					<img src={heroContent.historyImg} alt="Pizza préparée artisanalement" class="relative h-80 w-full rounded-3xl border-[3px] border-navy object-cover shadow-punch sm:h-96" />
				</div>
				<div>
					<p class="font-display text-lg text-tomato">Le savoir-faire Tino Pizz'</p>
					<h2 class="mt-1 font-display text-4xl font-bold text-navy sm:text-5xl">Un goût qui rassemble.</h2>
					<p class="mt-5 text-lg leading-relaxed text-slate-600">Ici, chaque pizza est préparée à la commande.
						Notre secret ? Une pâte maison, du temps, de bons produits et une bonne dose de passion.</p>
					<div class="mt-7 grid grid-cols-3 gap-3 text-center">
						<ValueCard icon='🌾' text='Pâte maison' />
						<ValueCard icon='🍅' text='Produits frais' />
						<ValueCard icon='🤌' text='Avec amour' />
					</div>
				</div>
			</div>
		</section>
	</main>

	<script>
		if (window.location.hash.includes("invite_token=")) {
			window.location.href = "/admin/" + window.location.hash;
		}
	</script>

	<Footer />
</Layout>
